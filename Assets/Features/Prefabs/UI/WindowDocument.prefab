--- !u!114 &1606519679083626170
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7711966257744754303}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0421\u0443\u0447\u043D\u043E\u0441\u0442\u044C 1\r\n\u043B\u0438\u0441\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
    \u0437\u0430\u0440\u043E\u043C\u0430\u043D\u0441\u0438\u0442\u044C\r\n\u041A\u0430\u0440\u0442\u0438\u043D\u043A\u0430\r\n\u0440\u0430\u0437\u043C\u0435\u0440
    256\u0445256\r\n\u0432 \u0440\u044B\u0436\u0438\u0445 \u0442\u043E\u043D\u0430\u0445\r\n\u0432
    \u0446\u0435\u043B\u043E\u043C \u044D\u0442\u043E \u0434\u0435\u0432\u0443\u0449\u043A\u0430,
    \u0432 \u043B\u0438\u0441\u044C\u0435\u0439 \u0448\u0443\u0431\u0435 \u0438 \u0440\u044B\u0436\u0430\u044F
    \u0438 \u0435\u0449\u0451 \u0441 \u043B\u0438\u0441\u044C\u0435\u0439 \u0431\u0435\u043B\u043E\u0439
    \u043C\u0430\u0441\u043A\u043E\u0439 \u0430 \u043B\u044F \u044F\u043F\u043E\u043D\u0441\u043A\u043E\u0439\r\n\u0424\u043B\u044D\u0439\u0432\u043E\u0440\r\n\u0421\u0432\u0435\u0442\u0441\u043A\u0430\u044F
    \u043B\u0438\u0441\u0438\u0446\u0430, \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0432\u0448\u0430\u044F
    \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E \u0447\u0451\u0440\u043D\u043E\u0439
    \u0432\u0434\u043E\u0432\u044B. \u041E\u0447\u0430\u0440\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F,
    \u0445\u0438\u0442\u0440\u0430\u044F \u0438 \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u043E
    \u043B\u0430\u0441\u043A\u043E\u0432\u0430\u044F. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
    \u0435\u0451 \u0448\u0443\u0431\u044B \u0441\u0434\u0435\u043B\u0430\u043D\u044B
    \u0438\u0437 \u0435\u0451 \u0436\u0435 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.\r\n\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435
    \u043E\u0442\u0432\u0435\u0442\u044B\r\n\u0412\u0438\u0434: \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u2014> \u0436\u0438\u0432\u043E\u0439\r\n\u041C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435:
    \r\n\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430:
    \r\n\u0421\u0443\u0447\u043D\u043E\u0441\u0442\u044C 2\r\n\u043A\u043E\u043B\u043E\u0431\u043E\u043A\r\n\u041A\u0430\u0440\u0442\u0438\u043D\u043A\u0430\r\n\u0440\u0430\u0437\u043C\u0435\u0440
    256\u0445256\r\n\u0447\u0442\u043E-\u0442\u043E \u0432\u0440\u043E\u0434\u0435
    \u043A\u0430\u043A \u0432 \u0444\u0438\u043B\u044C\u043C\u0435 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
    \u043D\u0430 \u043B\u0443\u043D\u0443 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043B\u0443\u043D\u0430\r\n\u0424\u043B\u044D\u0439\u0432\u043E\u0440\r\n\u0418\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u0432 \u0443\u0437\u043A\u0438\u0445 \u043A\u0440\u0443\u0433\u0430\u0445 \u0448\u0443\u043B\u0435\u0440.
    \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435,
    \u0447\u0442\u043E \u043E\u043D \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u0435\u043D
    \u0437\u0430 \u0440\u044F\u0434 \u043A\u0440\u0430\u0436, \u043D\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432
    \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0411\u044B\u043B
    \u043F\u043E\u0439\u043C\u0430\u043D \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0435
    \u0436\u0438\u0432\u043E\u0439 \u0432\u043E\u0434\u044B, \u043D\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u044D\u0442\u043E \u043E\u0431\u044B\u0447\u043D\u0430\u044F
    \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u043A\u0430.\r\n\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435
    \u043E\u0442\u0432\u0435\u0442\u044B\r\n\u0412\u0438\u0434: \u041D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043C\u043E\r\n\u041C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435:
    \r\n\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430:
    \u043D\u0430\u0432\u044B\u043A \u2014 \u043F\u0435\u0440\u0445\u043E\u0434\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 910380edf701f9e4c98009eac81cf104, type: 2}
  m_sharedMaterial: {fileID: 4402683659680024796, guid: c9da5dbb45013604892a8497d1ac1e08, type: 2}
