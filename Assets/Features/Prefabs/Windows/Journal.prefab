      value: "\u0421\u0432\u0435\u0442\u0441\u043A\u0430\u044F \u043B\u0438\u0441\u0438\u0446\u0430,
        \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0432\u0448\u0430\u044F
        \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E \u0447\u0451\u0440\u043D\u043E\u0439
        \u0432\u0434\u043E\u0432\u044B. \u041E\u0447\u0430\u0440\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F,
        \u0445\u0438\u0442\u0440\u0430\u044F \u0438 \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u043E
        \u043B\u0430\u0441\u043A\u043E\u0432\u0430\u044F. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
        \u0435\u0451 \u0448\u0443\u0431\u044B \u0441\u0434\u0435\u043B\u0430\u043D\u044B
        \u0438\u0437 \u0435\u0451 \u0436\u0435 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445
        \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445."
      objectReference: {fileID: 0}
