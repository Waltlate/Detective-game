    - target: {fileID: 233806938341753016, guid: 16b8bff0af0bac94d80f18a0ffb017d6, type: 3}
      propertyPath: m_Text
      value: "\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u0438\u0437 \u0442\u0440\u0451\u0445 \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u043E\u0432
        \u0431\u043E\u0433\u0430\u0442\u0435\u0439\u0448\u0435\u0439 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u0439
        \u0441\u0435\u043C\u044C\u0438 \u0421\u0438\u043C\u0431\u0438\u0440\u0441\u043A\u0430.
        \u0415\u0433\u043E \u043B\u0451\u0433\u043A\u043E\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u0430\u044F
        \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u044C \u043E\u0431\u043C\u0430\u043D\u0443\u043B\u0430
        \u0441\u043E\u0442\u043D\u0438 \u043B\u044E\u0434\u0435\u0439, \u0438 \u043D\u0435
        \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C
        \u043F\u043B\u0430\u043D\u0435. \u0417\u043D\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u043E
        \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
        \u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u043C\u043D\u043E\u0433\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 366392096980954312, guid: 16b8bff0af0bac94d80f18a0ffb017d6, type: 3}
