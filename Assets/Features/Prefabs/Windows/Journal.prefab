    - target: {fileID: 233806938341753016, guid: 16b8bff0af0bac94d80f18a0ffb017d6, type: 3}
      propertyPath: m_Text
      value: "\u0415\u0441\u0442\u044C \u0442\u0435, \u043A\u043E\u043C\u0443 \u043D\u0435
        \u0441\u0442\u043E\u0438\u0442 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
        \u0434\u043E\u0440\u043E\u0433\u0443, \u0438 \u043E\u043D\u0430 \u2014 \u043E\u0434\u043D\u0430
        \u0438\u0437 \u0442\u0430\u043A\u0438\u0445. \u0417\u043B\u0430\u044F \u0438
        \u043F\u0430\u043C\u044F\u0442\u044C \u0443 \u043D\u0435\u0451 \u0445\u043E\u0440\u043E\u0448\u0430\u044F.
        \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043E\u043D\u0430 \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C
        \u043D\u0430 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435. \u041D\u043E
        \u043F\u0440\u043E \u0435\u0439 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445
        \u043C\u043D\u043E\u0433\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0442.
        \u0425\u043E\u0434\u0438\u0442 \u0442\u0440\u043E\u043F\u0430\u043C\u0438,
        \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u0443\u043F\u0430\u0442\u044C
        \u043D\u0435\u043B\u044C\u0437\u044F."
      objectReference: {fileID: 0}
