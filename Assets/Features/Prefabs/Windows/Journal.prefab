    - target: {fileID: 233806938341753016, guid: 16b8bff0af0bac94d80f18a0ffb017d6, type: 3}
      propertyPath: m_Text
      value: "\u0418\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0432 \u0443\u0437\u043A\u0438\u0445
        \u043A\u0440\u0443\u0433\u0430\u0445 \u0448\u0443\u043B\u0435\u0440. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
        \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435, \u0447\u0442\u043E
        \u043E\u043D \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u0435\u043D
        \u0437\u0430 \u0440\u044F\u0434 \u043A\u0440\u0430\u0436, \u043D\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432
        \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
        \u0411\u044B\u043B \u043F\u043E\u0439\u043C\u0430\u043D \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0435
        \u0436\u0438\u0432\u043E\u0439 \u0432\u043E\u0434\u044B, \u043D\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
        \u0447\u0442\u043E \u044D\u0442\u043E \u043E\u0431\u044B\u0447\u043D\u0430\u044F
        \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u043A\u0430."
      objectReference: {fileID: 0}
