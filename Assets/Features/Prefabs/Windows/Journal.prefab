    - target: {fileID: 233806938341753016, guid: 16b8bff0af0bac94d80f18a0ffb017d6, type: 3}
      propertyPath: m_Text
      value: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u2014 \u043F\u043E\u043D\u044F\u0442\u0438\u0435
        \u0440\u0430\u0441\u0442\u044F\u0436\u0438\u043C\u043E\u0435, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u0432 \u043D\u0430\u0448\u0435 \u0432\u0440\u0435\u043C\u044F. \u0421\u0442\u0430\u0440\u0443\u0445\u0430
        \u0443\u0436\u0435 \u0434\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
        \u0436\u0438\u0432\u0451\u0442 \u0432 \u0421\u0438\u043C\u0431\u0438\u0440\u0441\u043A\u0435,
        \u0438 \u0437\u0430\u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043B\u0430
        \u0441\u0435\u0431\u044F \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0447\u0438\u0432\u0430\u044F
        \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
        \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043A\u0430\u043A
        \u043F\u043E\u043C\u043E\u0447\u044C, \u0442\u0430\u043A \u0438 \u043E\u0441\u043B\u043E\u0436\u043D\u0438\u0442\u044C
        \u0436\u0438\u0437\u043D\u044C \u043B\u044E\u0431\u043E\u043C\u0443.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 366392096980954312, guid: 16b8bff0af0bac94d80f18a0ffb017d6, type: 3}
