    - target: {fileID: 233806938341753016, guid: 16b8bff0af0bac94d80f18a0ffb017d6, type: 3}
      propertyPath: m_Text
      value: "\u041F\u0440\u0438\u0440\u043E\u0434\u0430 \u0421\u0438\u043C\u0431\u0438\u0440\u0441\u043A\u0430
        \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430. \u0421\u0432\u044F\u0437\u0430\u043D\u043E
        \u043B\u0438 \u044D\u0442\u043E \u0441 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
        \u0434\u043E\u0431\u044B\u0447\u0435\u0439 \u0438\u0437 \u0441\u0430\u043C\u044B\u0445
        \u043D\u0435\u0434\u0440 \u0433\u043E\u0440, \u0438\u043B\u0438 \u0436\u0435
        \u0441 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0435\u0439 \u2014 \u0432\u043E\u043F\u0440\u043E\u0441
        \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439. \u041D\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0442\u0432\u0430\u0440\u0438 \u0443\u043C\u043D\u0435\u0435 \u0438\u043D\u044B\u0445
        \u043B\u044E\u0434\u0435\u0439, \u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043B\u044E\u0434\u0438 \u2014 \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435
        \u0438\u043D\u044B\u0445 \u0442\u0432\u0430\u0440\u0435\u0439."
      objectReference: {fileID: 0}
